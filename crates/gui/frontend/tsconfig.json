{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node", "svelte", "vite/client"],
    "paths": {
      "/__ui.js": ["../panel-shim/ui.js"],
      "/__menu.js": ["../panel-shim/menu.js"],
      "/__mounts.js": ["../panel-shim/mounts.js"],
      "/__orphan.js": ["../panel-shim/orphan.js"],
      "/__paged-list.js": ["../panel-shim/paged-list.js"],
      "/__value-widget.js": ["../panel-shim/value-widget.js"],
      "/__schema-template.js": ["../panel-shim/schema-template.js"],
      "/__columns.js": ["../panel-shim/columns.js"],
      "/__finder.js": ["../panel-shim/finder.js"],
      "/__find-entry.js": ["../panel-shim/find-entry.js"],
      "/__keyhints.js": ["../panel-shim/keyhints.js"],
      "/__history.js": ["../panel-shim/history.js"],
      "/__help.js": ["../panel-shim/help.js"],
      "/__coalesce.js": ["../panel-shim/coalesce.js"],
      "/__select.js": ["../panel-shim/select.js"],
      "/__multi-select.js": ["../panel-shim/multi-select.js"],
      "/__file-actions.js": ["../panel-shim/file-actions.js"],
      "/__ignore.js": ["../panel-shim/ignore.js"],
      "/__watched.js": ["../panel-shim/watched.js"]
    }
  },
  "include": ["src", "tests", "types", "../panel-shim", "../default-config/panel-types"]
}
