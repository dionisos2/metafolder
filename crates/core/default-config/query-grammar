# Simplified query grammar — edit freely; transpiles to the normal DSL.
# Boolean skeleton: space or AND = AND, OR (or +), ! = NOT, parentheses.
query = q:or                       => $q
or    = items:and ++ ("OR" | "+")  => {join(" OR ", $items)}
and   = items:andterm +            => {join(" AND ", $items)}
andterm = "AND" u:unary            => $u
        | u:unary                  => $u
unary = "!" u:unary                => NOT $u
      | a:atom                     => $a
atom  = "(" q:query ")"            => ($q)
      | p:predicate                => $p

# Predicates — the part you edit most of the time. Comparison operators mirror
# the normal DSL (=, !=, <, <=, >, >=); ~ is regex match.
predicate =
    f:field "="  v:STRING   => $f = $v
  | f:field "="  n:NUMBER   => $f = $n
  | f:field "="  "true"     => $f = true
  | f:field "="  "false"    => $f = false
  | f:field "="  w:WORD     => $f = {str($w)}
  | f:field "!=" v:STRING   => $f != $v
  | f:field "!=" n:NUMBER   => $f != $n
  | f:field "!=" "true"     => $f != true
  | f:field "!=" "false"    => $f != false
  | f:field "!=" w:WORD     => $f != {str($w)}
  | f:field "~"  v:value    => $f MATCHES {str($v)}
  # Ordered substring matching: every whitespace-separated term must appear, in
  # order. `osm` walks a tree_ref path, `osmd` the field's own text. Quote the
  # value for several terms (`path osm "scien fic"`); a single term may be bare.
  | f:field "osm"  v:value  => osm($f, {str($v)})
  | f:field "osmd" v:value  => osmd($f, {str($v)})
  | f:field ">=" n:number   => $f >= $n
  | f:field "<=" n:number   => $f <= $n
  | f:field ">"  n:number   => $f > $n
  | f:field "<"  n:number   => $f < $n
  # Three-valued presence: `?` present, `!?` absent (value is Nothing), `??`
  # unknown (field never set). Multi-char forms come first (longest match).
  | f:field "!?"            => $f IS ABSENT
  | f:field "??"            => $f IS UNKNOWN
  | f:field "?"             => $f IS PRESENT
  | "under" v:value         => mfr_path ->* {str($v)}
  # Date macros: `modified`/`created` pick the field; relative (younger/older)
  # and absolute (since/before/between) forms. Dates are quoted ISO-8601.
  | df:datefield "younger" d:duration            => $df > @{now() - num($d)}
  | df:datefield "older"   d:duration            => $df < @{now() - num($d)}
  | df:datefield "since"   v:STRING               => $df >= @{str($v)}
  | df:datefield "before"  v:STRING               => $df < @{str($v)}
  | df:datefield "between" a:STRING "and" b:STRING => $df >= @{str($a)} AND $df <= @{str($b)}
  # Tags. Bare `#X` is the fuzzy finder: ordered-substring matching (osm) over
  # the tag path, so you can name a leaf without its ancestors (`#jazz`). A `/`
  # is an osm term separator, not a path anchor — `#a/b` matches a path with `a`
  # then `b` in order (not necessarily contiguous or root-anchored). Quote a
  # value to match one contiguous substring (`#"jeux video"`). `#=P` / `##=P`
  # anchor the *full* path from the root: `#=` its subtree, `##=` that exact
  # node; an unquoted slash-path is fine (`#=musique/jazz`). Distinct tokens
  # under maximal munch (`#` vs `#=` vs `##=`), so their order is immaterial. To
  # negate, keep a space: `! #musique` (a bare `!#` lexes as one symbol).
  | "##=" v:tagpath         => tag -> (mf_schema = "tag" AND path = {str($v)})
  | "#="  v:tagpath         => tag -> (mf_schema = "tag" AND path =>* {str($v)})
  | "#"   v:tagosm          => tag -> (mf_schema = "tag" AND osm(path, {str($v)}))
  # A pasted UUID — 32 hex characters, what the GUI's `Copy UUID` puts on the
  # clipboard — selects that one metarecord. `tag->UUID` selects the records
  # whose `tag` (or any ref field) points *at* it instead.
  | u:UUID                  => $u
  | f:field "->" u:UUID     => $f -> ($u)
  | "fav"                   => rating >= 4

# Field aliases: map a few names, pass the rest through. `p` = the file path
# (`mfr_path`); `path` is left free so it reads as the tag hierarchy field.
field  = "p"    => mfr_path
       | "size" => mfr_size
       | w:WORD => $w
value  = STRING | WORD

# Tag path values. `tagpath` keeps the slashes (a real path); `tagosm` turns
# them into osm term separators (spaces). A quoted string is passed through
# verbatim (one contiguous term / an exact path with spaces).
tagpath = v:STRING       => $v
        | ps:WORD ++ "/" => {join("/", $ps)}
tagosm  = v:STRING       => $v
        | ps:WORD ++ "/" => {join(" ", $ps)}
number = n:NUMBER "MB"   => {num($n) * 1048576}
       | n:NUMBER "mins" => {num($n) * 60}
       | n:NUMBER        => $n

# Date fields and durations (durations are milliseconds).
datefield = "modified" => mfr_mtime
          | "created"  => mfr_btime
duration  = n:NUMBER u:dur_unit => {num($n) * num($u)}
dur_unit  = ("s" | "sec" | "secs" | "second" | "seconds") => 1000
          | ("min" | "mins" | "minute" | "minutes")       => 60000
          | ("h" | "hr" | "hrs" | "hour" | "hours")        => 3600000
          | ("d" | "day" | "days")                         => 86400000
          | ("w" | "week" | "weeks")                       => 604800000
