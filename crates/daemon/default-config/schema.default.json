{
  "version": 1,
  "groups": [
    {
      "targets": ["tag"],
      "constraints": [
        { "field": "path", "type": "hierarchy_ref", "min": 1, "description": "Position of the tag in the tag hierarchy, one row per parent; its name is the last path segment." },
        { "field": "label", "type": "string", "max": 1, "description": "Optional display label, distinct from the hierarchical name." },
        { "field": "color", "type": "string", "default": "#888888", "description": "CSS color used to render the tag." },
        { "field": "always", "type": "bool", "max": 1, "default": false, "description": "gui-tag-classify.sh adds the tag without asking." },
        { "field": "partition", "type": "bool", "max": 1, "default": false, "description": "The tag's children exclude one another; gui-tag-classify.sh picks one of them by completion." },
        { "field": "sparse", "type": "bool", "max": 1, "default": false, "description": "gui-tag-classify.sh picks the tag's children by completion, one after another." }
      ]
    },
    {
      "targets": ["note"],
      "constraints": [
        { "field": "title", "type": "string", "min": 1, "max": 1, "description": "Short note title." },
        { "field": "body", "type": "string", "default": "", "description": "Note contents." },
        { "field": "tag", "type": "ref", "description": "Reference to a 'tag' metarecord (repeatable)." }
      ]
    },
    {
      "targets": ["bookmark"],
      "constraints": [
        { "field": "title", "type": "string", "min": 1, "max": 1, "description": "Bookmark title." },
        { "field": "url", "type": "string", "min": 1, "max": 1, "description": "Bookmarked URL." },
        { "field": "tag", "type": "ref", "description": "Reference to a 'tag' metarecord (repeatable)." }
      ]
    }
  ]
}
